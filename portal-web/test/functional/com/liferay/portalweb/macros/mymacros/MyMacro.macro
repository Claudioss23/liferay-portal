definition {

	macro assertScreenCustomValues {
		AssertTextEquals(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = ${customHeight});

		AssertTextEquals(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = ${customWidth});
	}

	macro setScreenCustomSize {
		WaitForEditable(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT");

		Type.sendKeys(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = ${height});

		Type.sendKeys(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = ${width});

		Click(locator1 = "MyPath#CUSTOM_SIZE_APPLY_BUTTON");
	}

}