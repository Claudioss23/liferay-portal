definition {

	macro gotoControlPanel {
		Click(locator1 = "MyPath#APPLICATIONS_MENU");

		Click(locator1 = "MyPath#CONTROL_PANEL");
	}

	macro viewControlPanelSectionText {
		AssertTextEquals(
			key_panelSection = ${panelSection},
			locator1 = "MyPath#PANEL_SECTION_TEXT",
			value1 = ${sectionText});
	}

}