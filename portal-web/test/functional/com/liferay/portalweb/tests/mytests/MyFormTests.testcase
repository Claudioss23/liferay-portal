@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");

			FormsAdmin.teardownForms();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "Check is possible to submit the form with two different languages"
	@priority = 5
	test CheckIsPossibleSubmitFormWithTwoDifferentLanguages {
		task ("Create Form with Text and Numeric fields") {
			FormsAdmin.addForm();

			Form.editName(formName = "Test Form");

			Form.gotoAddField(
				fieldPositionNumber = 0,
				fieldType = "Text");

			Form.editFieldLabelMetal(fieldValue = "Full Name");

			Form.closeSidebar();

			Form.gotoAddField(
				fieldPositionNumber = 1,
				fieldType = "Numeric");

			Form.editFieldLabelMetal(fieldValue = "Age");

			Form.closeSidebar();
		}

		task ("Translate fields to another language") {
			Form.addTranslation(localizedLanguage = "Portuguese (Brazil)");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Full Name",
				label = "Nome Completo");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Age",
				label = "Idade");
		}

		task ("Publish form and submit once for each language while validating the translated fields") {
			Form.publishForm();

			FormsAdminNavigator.gotoPublishedForm();

			FormPortlet.waitFormRenderer(text = "Submit");

			FormFields.viewTextField(
				fieldLabel = "Full Name",
				fieldName = "Text");

			FormFields.editText(
				fieldName = "Full Name",
				fieldValue = "Person Name 1");

			FormFields.viewTextField(
				fieldLabel = "Age",
				fieldName = "Numeric");

			FormFields.editText(
				fieldName = "Age",
				fieldValue = 22);

			FormPortlet.submitSuccessfully();

			Form.submitAgain();

			FormPortlet.waitFormRenderer(text = "Submit");

			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "português-Brasil");

			FormPortlet.waitFormRenderer(text = "Submit");

			FormFields.viewTextField(
				fieldLabel = "Nome Completo",
				fieldName = "Text");

			FormFields.editText(
				fieldName = "Nome Completo",
				fieldValue = "Person Name 2");

			FormFields.viewTextField(
				fieldLabel = "Idade",
				fieldName = "Numeric");

			FormFields.editText(
				fieldName = "Idade",
				fieldValue = 19);

			FormPortlet.submitSuccessfully();
		}

		task ("Validate submitted entries") {
			FormsAdmin.openFormsAdmin(siteURLKey = "guest");

			FormsAdminNavigator.gotoViewEntries();

			LexiconEntry.viewEntryContent(
				rowAny = 22,
				rowEntry = "Person Name 1");

			LexiconEntry.viewEntryContent(
				rowAny = 19,
				rowEntry = "Person Name 2");
		}
	}

}