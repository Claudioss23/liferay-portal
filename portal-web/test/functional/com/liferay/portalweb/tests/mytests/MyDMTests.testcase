@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		task ("Given the DM Portlet is added to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "DM Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "DM Page",
				widgetName = "Documents and Media");

			Navigator.gotoPage(pageName = "DM Page");

			DMDocument.enableActionsMenuOnPortlet();

			LexiconEntry.changeDisplayStyle(displayStyle = "list");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			DMFolder.tearDownCP();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "Check that is possible to edit a Document and Media"
	@priority = 5
	test CanEditDM {
		var dmEntryTitle = "DM File";
		var dmEntryTitleEdited = "DM Document Edited";
		var dmFileList = ListUtil.newListFromString("Document_1.txt,Document_2.doc", ",");

		task ("And create a Document and Media (Upload the file)") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = ${dmEntryTitle},
				groupName = "Guest",
				mimeType = "text/plain",
				sourceFileName = ListUtil.get(${dmFileList}, 0));

			Refresh();

			DMDocument.viewPG(
				dmDocumentFileName = ListUtil.get(${dmFileList}, 0),
				dmDocumentTitle = ${dmEntryTitle});

			Click(locator1 = "Icon#BACK");
		}

		task ("When the User edits the Documents and Media (Change DM name and the file)") {
			DMDocument.editPG(
				dmDocumentFileEdit = ListUtil.get(${dmFileList}, 1),
				dmDocumentFileNameEdit = ListUtil.get(${dmFileList}, 1),
				dmDocumentTitle = ${dmEntryTitle},
				dmDocumentTitleEdit = ${dmEntryTitleEdited});

			Click(locator1 = "Icon#BACK");
		}

		task ("Then the Documents and Media should be edited") {
			DMDocument.viewPG(
				dmDocumentFileName = ListUtil.get(${dmFileList}, 1),
				dmDocumentTitle = ${dmEntryTitleEdited});
		}
	}

}