@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		task ("Given the DM Portlet is added to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "DM Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "DM Page",
				widgetName = "Documents and Media");

			Navigator.gotoPage(pageName = "DM Page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			DMFolder.tearDownCP();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "Check that is possible to download a Document and Media"
	@priority = 5
	test CanDownloadDM {
		var dmEntryTitle = "DMTest";
		var dmFileList = ListUtil.newListFromString("Document_1.txt,Document_2.doc", ",");

		task ("And create 2 Documents and Media (Upload the file)") {
			var i = 0;

			for (var file : list ${dmFileList}) {
				var i = ${i} + 1;

				JSONDocument.addFileWithUploadedFile(
					dmDocumentTitle = "${dmEntryTitle} ${i}",
					groupName = "Guest",
					mimeType = "text/plain",
					sourceFileName = ${file});
			}

			Refresh();

			var i = 0;

			for (var file : list ${dmFileList}) {
				var i = ${i} + 1;

				DMDocument.viewPG(
					dmDocumentFileName = ${file},
					dmDocumentTitle = "${dmEntryTitle} ${i}");

				Click(locator1 = "Icon#BACK");
			}
		}

		task ("When the user download document from DMTest 1") {
			DMDocument.downloadPG(dmDocumentTitle = "${dmEntryTitle} 1");
		}

		task ("Then the file that was downloaded must be from DMTest 1") {
			DMDocument.assertFileNameFromTempFolder(fileName = ListUtil.get(${dmFileList}, 0));
		}

		task ("And DMTest 2 file should not be downloaded") {
			DMDocument.assertNoFileNameFromTempFolder(fileName = ListUtil.get(${dmFileList}, 1));
		}
	}

}