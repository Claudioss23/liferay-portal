@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		task ("Given the DM Portlet is added to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "DM Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "DM Page",
				widgetName = "Documents and Media");

			Navigator.gotoPage(pageName = "DM Page");

			DMDocument.enableActionsMenuOnPortlet();

			LexiconEntry.changeDisplayStyle(displayStyle = "list");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			DMFolder.tearDownCP();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "Check that is possible to delete a Document and Media"
	@priority = 4
	test CanDeleteDM {
		var dmEntryTitle1 = "DMTest 1";
		var dmEntryFile1 = "Document_1.txt";
		var dmEntryTitle2 = "DMTest 2";
		var dmEntryFile2 = "Document_2.doc";

		task ("And create 2 Documents and Media (Upload the file)") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = ${dmEntryTitle1},
				groupName = "Guest",
				mimeType = "text/plain",
				sourceFileName = ${dmEntryFile1});

			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = ${dmEntryTitle2},
				groupName = "Guest",
				mimeType = "application/msword",
				sourceFileName = ${dmEntryFile2});

			Refresh();

			DMDocument.viewPG(
				dmDocumentFileName = ${dmEntryFile1},
				dmDocumentTitle = ${dmEntryTitle1});

			Click(locator1 = "Icon#BACK");

			DMDocument.viewPG(
				dmDocumentFileName = ${dmEntryFile2},
				dmDocumentTitle = ${dmEntryTitle2});

			Click(locator1 = "Icon#BACK");
		}

		task ("When the User delete a document and media") {
			DMDocument.deletePG(dmDocumentTitle = ${dmEntryTitle1});
		}

		task ("Then DMTest 1 should not exist") {
			DMDocument.cannotViewCP(dmDocumentTitle = ${dmEntryTitle1});
		}

		task ("And DMTest 2 should exist") {
			DMDocument.viewPG(
				dmDocumentFileName = ${dmEntryFile2},
				dmDocumentTitle = ${dmEntryTitle2});
		}
	}

}