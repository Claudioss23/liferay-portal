@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		task ("Given the Blogs Portlet is added to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");

			Navigator.gotoPage(pageName = "Blogs Page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Check that is possible to search for blogs"
	@priority = 4
	test CanSearchBlogs {
		task ("And 2 Blog Entries exists") {
			JSONBlog.addEntry(
				entryContent = "Blog Entry Content 1",
				entryTitle = "Blog Entry Title 1");

			JSONBlog.addEntry(
				entryContent = "Blog Entry Content 2",
				entryTitle = "Blog Entry Title 2");

			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog Entry Content 1",
				entryTitle = "Blog Entry Title 1");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog Entry Content 2",
				entryTitle = "Blog Entry Title 2");
		}

		task ("When the User searches for Blog Entry 1") {
			SearchPortlets.searchEmbedded(searchTerm = "\"Blog Entry Title 1\"");
		}

		task ("Then Blog Entry 1 should display and Blog Entry 2 should not") {
			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "Blog Entry Title 1",
				searchAssetType = "Blogs Entry",
				searchTerm = "\"Blog Entry Title 1\"");

			SearchResultPortlet.viewSearchResultNotPresent(
				searchAssetTitle = "Blog Entry Title 2",
				searchAssetType = "Blogs Entry");
		}

		task ("And when the User searches for Blog Entry 2") {
			SearchPortlets.searchEmbedded(searchTerm = "\"Blog Entry Title 2\"");
		}

		task ("Then Blog Entry 2 should display and Blog Entry 1 should not") {
			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "Blog Entry Title 2",
				searchAssetType = "Blogs Entry",
				searchTerm = "\"Blog Entry Title 2\"");

			SearchResultPortlet.viewSearchResultNotPresent(
				searchAssetTitle = "Blog Entry Title 1",
				searchAssetType = "Blogs Entry");
		}
	}

}