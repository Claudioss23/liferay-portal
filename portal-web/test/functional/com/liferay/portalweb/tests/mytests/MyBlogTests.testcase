@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		task ("Given the Blogs Portlet is added to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");

			Navigator.gotoPage(pageName = "Blogs Page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "Check that is possible to delete a blog"
	@priority = 4
	test CanDeleteBlog {
		var blogEntryTitle1 = "Blog Entry Title 1";
		var blogEntryContent1 = "Blog Entry Content 1";
		var blogEntryTitle2 = "Blog Entry Title 2";
		var blogEntryContent2 = "Blog Entry Content 2";

		task ("And 2 Blog Entries exists") {
			JSONBlog.addEntry(
				entryContent = ${blogEntryContent1},
				entryTitle = ${blogEntryTitle1});

			JSONBlog.addEntry(
				entryContent = ${blogEntryContent2},
				entryTitle = ${blogEntryTitle2});

			Refresh();

			BlogsEntry.viewEntryPG(
				entryContent = ${blogEntryContent1},
				entryTitle = ${blogEntryTitle1});

			BlogsEntry.viewEntryPG(
				entryContent = ${blogEntryContent2},
				entryTitle = ${blogEntryTitle2});
		}

		task ("When the User deletes Blog Entry 1") {
			BlogsEntry.moveToRecycleBinPG(
				entryContent = ${blogEntryContent1},
				entryTitle = ${blogEntryTitle1});
		}

		task ("Then Blog Entry 1 should not exist") {
			BlogsEntry.viewNoPG(entryTitle = ${blogEntryTitle1});
		}

		task ("And Blog Entry 2 should exist") {
			BlogsEntry.viewEntryPG(
				entryContent = ${blogEntryContent2},
				entryTitle = ${blogEntryTitle2});
		}
	}

}