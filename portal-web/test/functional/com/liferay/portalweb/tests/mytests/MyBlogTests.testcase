@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		task ("Given the Blogs Portlet is added to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				column = 1,
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");

			Navigator.gotoPage(pageName = "Blogs Page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Check that is possible to edit a blog"
	@priority = 5
	test CanEditBlog {
		task ("And a Blog Entry exists") {
			JSONBlog.addEntry(
				entryContent = "Blog Entry Content",
				entryTitle = "Blog Entry Title");

			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog Entry Content",
				entryTitle = "Blog Entry Title");
		}

		task ("When the User edits the blog Entry") {
			Blogs.editEntryPG(
				entryContent = "Blog Entry Content",
				entryContentEdit = "Edited Blog Entry Content",
				entryTitle = "Blog Entry Title",
				entryTitleEdit = "Edited Blog Entry Title");
		}

		task ("Then the Blog Entry should be edited") {
			BlogsEntry.viewEntryPG(
				entryContent = "Edited Blog Entry Content",
				entryTitle = "Edited Blog Entry Title");
		}
	}

}