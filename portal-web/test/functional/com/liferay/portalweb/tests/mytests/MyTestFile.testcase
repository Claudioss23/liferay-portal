@component-name = "portal"
definition {

	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test CanDefineDXPCustomScreenSize {
		Click(locator1 = "MyPath#SIMULATION_MENU");

		Click(locator1 = "MyPath#CUSTOM_SIZE_BUTTON");

		Type.sendKeys(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = 1920);

		Type.sendKeys(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = 1080);

		Click(locator1 = "MyPath#CUSTOM_SIZE_APPLY_BUTTON");

		Click(locator1 = "MyPath#SIMULATION_MENU");

		Click(locator1 = "MyPath#SIMULATION_MENU");

		Type.sendKeys(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = 1920);

		Type.sendKeys(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = "keys=CONTROL,a");

		Type.sendKeys(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = 1080);

		Click(locator1 = "MyPath#CUSTOM_SIZE_APPLY_BUTTON");

		Click(locator1 = "MyPath#SIMULATION_MENU");

		Click(locator1 = "MyPath#SIMULATION_MENU");

		AssertTextEquals(
			key_id = "height",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = 1920);

		AssertTextEquals(
			key_id = "width",
			locator1 = "MyPath#CUSTOM_SIZE_INPUT",
			value1 = 1080);
	}

}