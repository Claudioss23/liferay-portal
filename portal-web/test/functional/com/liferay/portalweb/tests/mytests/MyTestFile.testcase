@component-name = "portal"
definition {

	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	@description = "Access Applications Menu and validate CONFIGURATION string at Control Panel"
	@priority = 2
	test AssertConfigurationSectionPresentInApplicationsMenu {
		MyMacro.gotoControlPanel();

		MyMacro.viewControlPanelSectionText(
			sectionText = "Configuration",
			panelSection = "configuration");
	}

}