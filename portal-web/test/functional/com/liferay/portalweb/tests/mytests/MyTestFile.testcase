@component-name = "portal"
definition {

	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 3
	test CanDefineDXPCustomScreenSize {
		var customHeight = 1920;
		var customWidth = 1080;

		MyMacro.gotoSimulationScreenSize(screenSizeLabel = "Custom");

		MyMacro.setScreenCustomSize(
			height = ${customHeight},
			width = ${customWidth});

		MyMacro.closeSimulationMenu();

		MyMacro.gotoSimulationScreenSize(screenSizeLabel = "Custom");

		MyMacro.setScreenCustomSize(
			height = ${customHeight},
			width = ${customWidth});

		MyMacro.closeSimulationMenu();

		MyMacro.gotoSimulationScreenSize(screenSizeLabel = "Custom");

		MyMacro.assertScreenCustomValues(
			customHeight = ${customHeight},
			customWidth = ${customWidth});
	}

}