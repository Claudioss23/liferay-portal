@component-name = "portal"
definition {
    property testray.main.component.name = "Navigation";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    tearDown {
        User.logoutAndLoginPG(
            userLoginEmailAddress = "test@liferay.com",
            userLoginFullName = "Test Test");
    }

    @description = "Set Screen size to custom and validate values"
    @priority = "5"
    test CanDefineDXPCustomScreenSize {
        Click(locator1 = "MyPath#SIMULATION_MENU");

        Click(locator1 = "MyPath#CUSTOM_SIZE_BUTTON");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_HEIGHT",
            value1 = "keys=CONTROL,a");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_HEIGHT",
            value1 = "1920");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_WIDTH",
            value1 = "keys=CONTROL,a");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_WIDTH",
            value1 = "1080");

        Click(locator1 = "MyPath#CUSTOM_SIZE_APPLY_BUTTON");

        Click(locator1 = "MyPath#SIMULATION_MENU");

        Click(locator1 = "MyPath#SIMULATION_MENU");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_HEIGHT",
            value1 = "keys=CONTROL,a");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_HEIGHT",
            value1 = "1920");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_WIDTH",
            value1 = "keys=CONTROL,a");

        Type.sendKeys(
            locator1 = "MyPath#CUSTOM_SIZE_WIDTH",
            value1 = "1080");

        Click(locator1 = "MyPath#CUSTOM_SIZE_APPLY_BUTTON");

        Click(locator1 = "MyPath#SIMULATION_MENU");

        Click(locator1 = "MyPath#SIMULATION_MENU");

        AssertTextEquals(
            locator1 = "MyPath#CUSTOM_SIZE_HEIGHT",
            value1 = "1920");

        AssertTextEquals(
            locator1 = "MyPath#CUSTOM_SIZE_WIDTH",
            value1 = "1080");
    }

}
