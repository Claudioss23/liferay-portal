@component-name = "portal"
definition {

	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	@description = "Access Applications Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test AssertConfigurationSectionPresentInApplicationsMenu {
		Click(locator1 = "MyPath#APPLICATIONS_MENU");

		Click(locator1 = "MyPath#CONTROL_PANEL");

		AssertTextEquals(
			locator1 = "MyPath#PANEL_CONFIGURATION_TEXT",
			value1 = "Configuration");
	}

}