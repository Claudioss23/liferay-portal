@component-name = "portal"
definition {

	property testray.main.component.name = "Navigation";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 3
	test CanDefineDXPCustomScreenSize {
		MyMacro.previewScreenCustomSize(
			height = 1920,
			width = 1080);

		Click(locator1 = "MyPath#SIMULATION_MENU");

		MyMacro.previewScreenCustomSize(
			height = 1920,
			width = 1080);

		Click(locator1 = "MyPath#SIMULATION_MENU");

		Click(locator1 = "MyPath#SIMULATION_MENU");

		MyMacro.assertScreenCustomValues();
	}

}