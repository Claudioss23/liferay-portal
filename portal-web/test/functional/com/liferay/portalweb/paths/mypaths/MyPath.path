<html>
<head>
<title>MyPath</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyPath</td></tr>
</thead>

<tbody>
<tr>
	<td>SIMULATION_MENU</td>
	<td>//button[@data-qa-id='simulation']</td>
	<td></td>
</tr>
<tr>
	<td>SCREEN_SIZE_BUTTON</td>
	<td>//div[contains(@class,'row size-selector')]//button[span[text()='${key_screenSize}']]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_SIZE_INPUT</td>
	<td>//div[contains(@id,'customSizeSelector')]//input[contains(@id,'${key_id}')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_SIZE_APPLY_BUTTON</td>
	<td>//button[@aria-label='Apply Custom Size']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>